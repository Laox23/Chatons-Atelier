                  "id": "dc49788b-13c3-4e2c-b960-7db9591e4519",
                  "label": "Amitié",
                  "nature": "regle"
                }
              },
              {
                "text": " · ",
                "type": "text"
              },
              {
                "type": "mention",
                "attrs": {
                  "id": "63e0815a-642e-49cc-a858-2f86240b2e3a",
                  "label": "Cœur",
                  "nature": "regle"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "86ad8e0b-e2f1-4027-9f21-2d6bf73db858",
      "styles": {},
      "typeId": "03316a1c-6ecc-4528-b2af-fb7906793300",
      "contenu": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "text": "Fin de la séance et aventure finie : le chaton gagne 2 points d’expérience.",
                "type": "text"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "e188701e-a65d-458e-8d29-479ce51944da",
      "styles": {},
      "typeId": "08744da8-f883-4424-aeb1-0f8554a83833",
      "contenu": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "mention",
                "attrs": {
                  "id": "9dd70904-bdc9-4aab-9ee3-26a6a0af7a68",
                  "label": "Expérience",
                  "nature": "regle"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "e316f175-3ba2-4573-9469-7cceef55f9e8",
      "styles": {},
      "typeId": "0f601108-ce80-4f5f-b790-368ddc11ee29",
      "contenu": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "text": "Fin de la campagne Solo. Le chaton retrouvera l’Arbrachat plus tard, dans la campagne Intro.",
                "type": "text"
              }
            ]
          }
        ]
      }
    }
  ],
  "ambiance": "la pluie, le vent, puis une nuit au sec"
}
