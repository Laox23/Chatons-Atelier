                "text": " · ",
                "type": "text"
              },
              {
                "type": "mention",
                "attrs": {
                  "id": "68467360-fb0f-4309-841e-9c601a35ebbb",
                  "label": "Talents",
                  "nature": "regle"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "6644ad7a-b9c4-4e34-a188-e600dfcccd71",
      "styles": {},
      "typeId": "35c92e07-bb4e-4853-9a58-9627ad3bd6f7",
      "contenu": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "text": "Un talent s’apprend par l’expérience, ou auprès d’un professeur : ici, Charbon. À notre table, un talent coûte 2 points.",
                "type": "text"
              },
              {
                "type": "hardBreak"
              },
              {
                "text": "Le chaton note le talent sur sa fiche, et les points qu’il lui reste.",
                "type": "text"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "79700aff-f012-4c38-b769-ad39b9029582",
      "styles": {},
      "typeId": "0f601108-ce80-4f5f-b790-368ddc11ee29",
      "contenu": {
