        },
        {
          "id": "668d3d95-b858-4e52-911e-658d6e1a585d",
          "typeId": "032a1f8f-68cf-43b8-9871-eaa604c51e94",
          "contenu": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "L’herbe est sombre et pleine de chardons. L’eau du ruisseau est boueuse. L’écorce des chênes est fendue. Seule la pomme brille encore.",
                    "type": "text"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Près du pommier, quatre ",
                    "type": "text"
                  },
                  {
                    "type": "mention",
                    "attrs": {
                      "id": "861775ee-dfd0-4359-adf8-f582176e5bb5",
                      "label": "Souris maléfiques",
                      "nature": "pnj",
                      "mentionSuggestionChar": "@"
                    }
                  },
                  {
                    "text": " chuchotent : « Vite, prenons la pomme ! Le maître sera content. »",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        },
        {
