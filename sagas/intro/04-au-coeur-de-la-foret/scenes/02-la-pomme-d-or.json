                      "label": "Miagie",
                      "nature": "regle",
                      "mentionSuggestionChar": "@"
                    }
                  },
                  {
                    "text": " de la forêt leurs fait retrouver la mémoire.",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        },
        {
