            "content": [
              {
                "text": "Les chatons remarquent que des traces fraiches sont en direction du centre de la forêt, cela inquiète beaucoup ",
                "type": "text"
              },
              {
                "type": "mention",
                "attrs": {
                  "id": "e4b0a745-321c-4de8-b0c6-a40d96ab1f96",
                  "label": "Victorin",
                  "nature": "pnj",
                  "mentionSuggestionChar": "@"
                }
              },
              {
                "text": " il faut les suivre au plus vite.  ",
                "type": "text"
              }
            ]
          }
        ]
