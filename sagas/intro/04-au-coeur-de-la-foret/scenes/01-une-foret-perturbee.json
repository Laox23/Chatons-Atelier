                      "label": "Victorin",
                      "nature": "pnj",
                      "mentionSuggestionChar": "@"
                    }
                  },
                  {
                    "text": " vous mène vers la ",
                    "type": "text"
                  },
                  {
                    "type": "mention",
                    "attrs": {
                      "id": "56c9ae0c-56bc-4eed-a97d-c332e8d4d156",
                      "label": "Forêt endormie",
                      "nature": "lieu",
                      "mentionSuggestionChar": "@"
                    }
                  },
                  {
                    "text": ". Vous passez devant d’anciens vestiges des ",
                    "type": "text"
                  },
                  {
                    "type": "mention",
                    "attrs": {
                      "id": "cd8c5986-c405-417b-a9ab-d42ae158679c",
                      "label": "Gros-tout-nus",
                      "nature": "mot",
                      "mentionSuggestionChar": "@"
                    }
                  },
                  {
                    "text": ".",
                    "type": "text"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "En approchant, vous remarquez que la forêt commence à être déboisée.",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "d1430ed3-2dc4-4b23-8d0a-23d02dc1ac52",
          "typeId": "03316a1c-6ecc-4528-b2af-fb7906793300",
          "contenu": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Montrer la ",
                    "type": "text"
                  },
                  {
                    "type": "mention",
                    "attrs": {
                      "id": "56c9ae0c-56bc-4eed-a97d-c332e8d4d156",
                      "label": "Forêt endormie",
                      "nature": "lieu",
                      "mentionSuggestionChar": "@"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "a5154d6a-b79d-411f-adac-f0b2126b03ce",
      "styles": {},
      "typeId": "032a1f8f-68cf-43b8-9871-eaa604c51e94",
      "contenu": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "text": "Quand vous entrez dans la forêt, l’ambiance change du tout au tout : il fait sombre, la forêt est hostile.",
                "type": "text"
              }
            ]
          }
        ]
      },
      "parties": [
        {
          "id": "5f98d43d-5c8c-4631-8af1-88fd315427be",
          "typeId": "03316a1c-6ecc-4528-b2af-fb7906793300",
          "contenu": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "mention",
                    "attrs": {
                      "id": "e4b0a745-321c-4de8-b0c6-a40d96ab1f96",
                      "label": "Victorin",
                      "nature": "pnj",
                      "mentionSuggestionChar": "@"
                    }
                  },
                  {
                    "text": " est surpris et inquiet. L’angoisse l’empêche d’être efficace : il reste en retrait.",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "c90f1865-c490-4a59-84d5-29f81c45701c",
