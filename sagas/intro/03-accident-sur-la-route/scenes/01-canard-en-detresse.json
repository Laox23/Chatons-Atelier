      "contenu": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "text": "Les chatons ont passé la nuit dans un bosquet. Pendant la nuit, ils ont entendu des bruits de mécanique, des cris, des hurlements.",
                "type": "text"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "a3a1cbc5-4c73-4ce1-87d2-65649a33320a",
      "styles": {},
