      "contenu": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "text": "Au petit matin, un canard en uniforme vert arrive vers vous. Il a été malmené : ses plumes sont froissées, ses yeux pochés.",
                "type": "text"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "text": "C’est ",
                "type": "text"
              },
              {
                "type": "mention",
                "attrs": {
                  "id": "e4b0a745-321c-4de8-b0c6-a40d96ab1f96",
                  "label": "Victorin",
                  "nature": "pnj"
                }
              },
              {
                "text": ".",
                "type": "text"
              }
            ]
          }
        ]
      },
      "parties": [
        {
