          "typeId": "53857dd5-4db0-4e8e-983b-d55b52cfecfc",
          "contenu": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "La compagnie peut aider des chatons perdus : partout où la nature est présente, un garde forestier n’est pas loin. Un chaton pourrait même, un jour, vouloir en devenir membre.",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        }
