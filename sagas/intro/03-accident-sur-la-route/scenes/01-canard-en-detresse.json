                    "type": "mention",
                    "attrs": {
                      "id": "3e2a0bc2-1a8f-422d-8693-92c1e8201d30",
                      "label": "Garde forestier",
                      "nature": "mot",
                      "mentionSuggestionChar": "@"
                    }
                  },
                  {
                    "text": " reçoit ses missions par pigeon voyageur. La compagnie entretient de petits chalets dans l",
                    "type": "text"
                  }
                ]
              }
            ]
