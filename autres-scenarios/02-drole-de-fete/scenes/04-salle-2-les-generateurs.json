  "encarts": [
    {
      "id": "b3-generateurs",
      "styles": {},
      "typeId": "032a1f8f-68cf-43b8-9871-eaa604c51e94",
      "contenu": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "text": "Une salle immense. Des boîtes de métal grandes comme des maisons, couvertes de boutons, d’aiguilles et de petites fenêtres éteintes. Des serpents noirs partent de partout et montent vers le plafond. Une armoire de métal, haute comme un arbre, garde ses portes fermées.",
                "type": "text"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "text": "Au fond, une porte rouillée est entrouverte. Il en sort de la poussière, et une odeur âcre qui pique le nez.",
                "type": "text"
              }
            ]
          }
        ]
      },
      "libelle": "Les générateurs",
      "parties": [
        {
          "id": "b3-generateurs-2",
          "typeId": "176be3ce-dc02-4178-8e16-4969f7c8b86b",
          "contenu": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Ce sont les générateurs qui faisaient tourner la grande roue, avec leurs tableaux électriques et leurs armoires de commande.",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "b3-markus",
      "styles": {},
      "typeId": "032a1f8f-68cf-43b8-9871-eaa604c51e94",
      "contenu": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "text": "Entre deux machines, quelque chose bouge. Des dizaines de pattes cliquettent sur le métal. Un mille-pattes géant, tout bleuté, déroule son long corps et lève la tête vers vous.",
                "type": "text"
              }
            ]
          }
        ]
      },
      "libelle": "Rencontre",
      "parties": [
        {
          "id": "b3-markus-2",
          "qui": "Markus",
          "typeId": "ae6fa8bf-a5b6-4184-8d17-ddaa75e89898",
          "contenu": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "Qui… qui fait tout ce vacarme ? Cent ans que je dors ici, cent ans ! Et on vient me secouer comme un tapis !",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "b3-markus-3",
          "champs": {
            "rate": "Markus cliquette de colère : il veut les chasser de chez lui.",
            "sorte": "groupe",
            "reussi": "Markus se calme, s’enroule et bâille. Il les laisse passer, et répond même à quelques questions. #markus-amadoue",
            "qualite": "mignon",
            "difficulte": "3"
          },
          "typeId": "1cd6999c-83e4-41da-86af-51037488b239",
          "contenu": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "text": "L’amadouer.",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "b3-markus-querelle",
      "champs": {
        "perd": "Markus les repousse jusqu’à la coursive. Pour passer, il faudra revenir l’amadouer, ou ruser. #markus-a-chasse-les-chatons",
        "enjeu": "le droit de passer dans la salle",
        "gagne": "Markus se réfugie derrière l’armoire et refuse de leur adresser la parole. #markus-vaincu",
        "sorte": "crocs",
        "adversaires": "pnj-markus"
      },
      "styles": {},
