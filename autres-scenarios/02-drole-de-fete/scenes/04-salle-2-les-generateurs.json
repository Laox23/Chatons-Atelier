{
  "id": "sc-salle-2",
  "but": "Les machines de la grande roue ; amadouer Markus ou se quereller avec lui.",
  "piece": true,
  "titre": "Salle 2 · Les générateurs",
  "donjon": "Le donjon de la faille",
  "statut": "prete",
