        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Ouvre « Faits de vos scénarios », en bas de la scène en Création. "
              },
              {
                "type": "text",
                "text": "#porte-ouverte",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "text",
                "text": " vient d'une seule suite et n'est attendu qu'ici : Chatons dit d'où il vient et propose « Remplacer par l'issue ». "
              },
              {
                "type": "fait",
                "attrs": {
                  "id": "ami-de-charbon",
                  "label": "ami-de-charbon"
                }
              },
              {
                "type": "text",
                "text": " a deux causes : il reste un fait de campagne."
              }
            ]
          }
        ]
      }
    },
    {
      "id": "sd2-porte",
      "typeId": "1cd6999c-83e4-41da-86af-51037488b239",
      "styles": {},
      "libelle": "Le loquet",
      "contenu": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Soulever le vieux loquet."
              }
            ]
          }
        ]
      },
      "champs": {
        "sorte": "groupe",
        "qualite": "malin",
        "difficulte": "1",
        "reussi": "La porte grince et s'ouvre. #porte-ouverte",
        "rate": "Le loquet ne bouge pas."
      }
    },
    {
