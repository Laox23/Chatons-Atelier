{
  "id": "sd-faits",
  "titre": "La porte du grenier",
  "ambiance": "poussière dorée, silence",
  "statut": "prete",
  "but": "Montrer le passage des anciens faits : un fait posé par une seule suite se remplace par l'issue ; un fait à deux causes reste un fait de campagne.",
  "encarts": [
    {
      "id": "sd2-intro",
